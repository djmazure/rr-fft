 "diagnosis": {
  "matches": [
   {
    "id": "DS-fwft-output-valid-desync-001",
    "title": "FWFT/AXI-S datapath drops or duplicates a word at backpressure edges \u2014 output-valid not gated on the registered consume",
    "score": 2,
    "why": [
     "regex"
    ],
    "root_causes": [
     {
      "summary": "`rd_en_r` and the `(not full)` term are sampled in DIFFERENT cycles, so they desync at every backpressure edge: the captured word and the pop pointer drift \u2192 a word is popped-but-never-emitted (SKIP) or double-emitted. The recurring mux_ep_ddr bug class (VFIFO-T1.1/T2.2, 3 instances).",
      "fix": "Gate the registered output VALID on the ACTUAL registered consume (the same `rd_en_r`/pop event that advanced the pointer), NOT on a fresh `din_valid and not full` projection. One source of truth for 'a word left the stage' per cycle. (H.81)"
     }
    ],
    "drill_down": "rr_diagnose_walk(signature_id=\"DS-fwft-output-valid-desync-001\", answers=[])"
   },
   {
    "id": "DS-rr-linux-sdcard-stale-workspace-001",
    "title": "Board boots the OLD design after rebuild+flash \u2014 rr linux --refresh leaves Vitis hw_platform workspace caches stale",
    "score": 2,
    "why": [
     "regex"
    ],
    "root_causes": [
     {
      "summary": "`rr linux fsbl --refresh` (and friends) build incrementally against the Vitis hw_platform workspace caches under sw/linux/src/{fsbl,bsp,device_tree}_workspace/, which retain the OLD .bit + xparameters.h / pl.dtsi across bitstream-edit cycles \u2014 so a fresh SD still embeds the old design.",
      "fix": "Scorched clean before the rebuild: `rm -rf .routertl_cache .Xil project build .deps.ok bitstream dcp reports` AND the `sw/linux/src/*_workspace/` dirs, then rebuild. (H.74; RTL-P1.63/P1.64 track making --refresh sufficient.)"
     }
    ],
    "drill_down": "rr_diagnose_walk(signature_id=\"DS-rr-linux-sdcard-stale-workspace-001\", answers=[])"
   },
   {
    "id": "DS-xpm-fwft-sim-dout-valid-lastword-001",
    "title": "XPM FWFT FIFO: RTL reads DOUT same-cycle-as-rd_en \u2014 sim-clean but latches a STALE last word on silicon",
    "score": 2,
    "why": [
     "regex"
    ],
    "root_causes": [
     {
      "summary": "The stock xpm_fifo_sync sim model (READ_MODE=fwft) keeps DOUT VALID at the rd_en/pop cycle even for the LAST word, so RTL reading DOUT same-cycle-as-rd_en always gets good data in sim. Real silicon invalidates DOUT at the pop/empty edge for the final entry \u2192 the same RTL latches stale. A sim-model FIDELITY gap, not an RTL-only bug.",
      "fix": "Do not consume FWFT DOUT in the rd_en cycle for the final entry \u2014 register the valid/empty handshake and gate the read on a stable valid. Re-verify against silicon (or a faithful FWFT model), since the stock XPM sim model masks this class. (RTL-P3.746; pairs with DS-fwft-output-valid-desync-001.)"
     }
    ]
   }
  ]
 },
